{
  "name": "leoms",
  "version": "0.6.0-beta",
  "description": "Inspector and orchestrator for multi-language, multi-repo workspace",
  "license": "MIT",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md"
  ],
  "keywords": [
    "monorepo",
    "multi-repo",
    "orchestrator",
    "pnpm",
    "composer",
    "typescript",
    "php",
    "gatekeeper"
  ],
  "bin": {
    "leoms": "./bin/leoms.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:ui": "vite",
    "build:cli": "tsup",
    "build:ui": "tsc -p tsconfig.ui.json --noEmit && vite build",
    "build": "pnpm build:cli && pnpm build:ui",
    "start": "node ./bin/leoms.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "tauri": "tauri",
    "dev:desktop": "node ./bin/leoms.js desk dev",
    "build:desktop": "node ./bin/leoms.js desk build",
    "desk:doctor": "node ./bin/leoms.js desk doctor"
  },
  "leoms": {
    "desktop": {
      "companion": {
        "command": "pnpm dev ui -p 3200 --no-open",
        "port": 3200,
        "healthCheck": "http://localhost:3200/api/health"
      }
    }
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "lucide-react": "^1.46.0",
    "picocolors": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
